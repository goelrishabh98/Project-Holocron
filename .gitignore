# --- Project Holocron Custom GitIgnore ---

# --- OS Specific ---
.DS_Store
Thumbs.db
.directory

# --- Web (Astro / Node) ---
node_modules/
dist/
.astro/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
!.env.example

# --- Python (Jinja2 / Scripts) ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.env

# --- LaTeX (Resume Engine) ---
# This ignores all the "noise" files LaTeX creates during compilation
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.blg
*.bbl
*.xdv

# --- Build Outputs ---
# Generated resume files (CI builds these)
resume.pdf
resume/resume.tex
resume/resume.pdf
web/public/resume.pdf

# --- IDEs ---
.vscode/

CLAUDE.md
.claude