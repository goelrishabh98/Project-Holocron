---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const publications = await getCollection("publications");
const sorted = publications.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Publications">
  <h1 class="text-3xl font-bold">Publications</h1>
  <p class="mt-2 text-text-muted">Research papers and academic publications.</p>

  <div class="mt-8 space-y-6">
    {sorted.map((pub) => (
      <div class="rounded-lg border border-border bg-bg-card p-6">
        <h2 class="text-lg font-semibold text-text">{pub.data.title}</h2>
        <p class="mt-1 text-sm text-text-muted">{pub.data.authors.join(", ")}</p>
        <p class="mt-1 text-sm text-accent">{pub.data.venue}</p>
        <time class="mt-1 block text-sm text-text-muted">
          {pub.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long" })}
        </time>
        {pub.data.abstract && (
          <p class="mt-3 text-sm text-text-muted">{pub.data.abstract}</p>
        )}
        <div class="mt-4 flex gap-4 text-sm">
          {pub.data.doi && (
            <a href={`https://doi.org/${pub.data.doi}`} class="text-accent hover:text-accent-hover">
              DOI &rarr;
            </a>
          )}
          {pub.data.pdf && (
            <a href={pub.data.pdf} class="text-accent hover:text-accent-hover">
              PDF &rarr;
            </a>
          )}
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          {pub.data.tags.map((tag: string) => (
            <span class="rounded-full bg-bg px-2 py-0.5 text-xs text-accent">{tag}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
