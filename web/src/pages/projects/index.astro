---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjectsByCategory } from "../../lib/projects";
import { url } from "../../lib/url";

const personal = await getProjectsByCategory("personal");
---

<BaseLayout title="Projects" description="Personal projects, competition teams, and things built for the fun of it.">
  <h1 class="text-3xl font-bold">Projects</h1>
  <p class="mt-2 max-w-2xl text-text-muted">
    Personal builds, competition teams, and things made for the fun of it. For
    academic work, see <a href={url("/research")} class="text-accent hover:text-accent-hover">research</a>.
  </p>

  {personal.length > 0 ? (
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {personal.map((project) => (
        <ProjectCard
          title={project.data.title}
          slug={project.data.slug}
          tagline={project.data.tagline}
          tags={project.data.tags}
          status={project.data.status}
          draft={project.data.draft}
        />
      ))}
    </div>
  ) : (
    <p class="mt-8 text-text-muted">No personal projects yet.</p>
  )}
</BaseLayout>
