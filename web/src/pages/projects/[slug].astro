---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { getVisibleProjects } from "../../lib/projects";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const projects = await getVisibleProjects();
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.tagline}>
  <article class="py-4">
    <a href={url("/projects")} class="text-sm text-text-muted hover:text-accent">&larr; All Projects</a>

    <header class="mt-4">
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-bold">{project.data.title}</h1>
        <span class="rounded-full bg-bg-card px-2 py-0.5 text-xs text-text-muted">{project.data.status}</span>
      </div>
      <p class="mt-1 text-lg text-accent">{project.data.tagline}</p>
      <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-text-muted">
        <time>{project.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long" })}</time>
        {project.data.repo && (
          <a href={project.data.repo} class="text-accent hover:text-accent-hover">Repository &rarr;</a>
        )}
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        {project.data.tags.map((tag: string) => (
          <span class="rounded-full bg-bg-card px-2 py-0.5 text-xs text-accent">{tag}</span>
        ))}
      </div>
    </header>

    <div class="prose prose-invert mt-8 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
