---
import { getVault } from "../lib/vault";
const vault = getVault();
---

<footer class="border-t border-border mt-16">
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
      <p class="text-sm text-text-muted">
        &copy; {new Date().getFullYear()} {vault.meta.name}
      </p>
      <div class="flex gap-4 text-sm text-text-muted">
        <a href={`https://${vault.meta.github}`} class="hover:text-text">GitHub</a>
        <a href={`https://${vault.meta.linkedin}`} class="hover:text-text">LinkedIn</a>
        <a href={`mailto:${vault.meta.email}`} class="hover:text-text">Email</a>
      </div>
    </div>
  </div>
</footer>
