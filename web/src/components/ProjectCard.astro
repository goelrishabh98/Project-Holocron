---
interface Props {
  title: string;
  slug: string;
  tagline: string;
  tags: string[];
  status: string;
  category?: string;
}

import { url } from "../lib/url";

const { title, slug, tagline, tags, status, category } = Astro.props;
---

<a href={url(`/projects/${slug}`)} class="group block rounded-lg border border-border bg-bg-card p-6 transition-colors hover:bg-bg-hover">
  <div class="flex items-start justify-between gap-2">
    <h3 class="text-lg font-semibold text-text group-hover:text-accent">{title}</h3>
    <div class="flex shrink-0 items-center gap-2">
      {category && (
        <span class="rounded-full border border-accent/40 px-2 py-0.5 text-xs capitalize text-accent">{category}</span>
      )}
      <span class="rounded-full bg-bg px-2 py-0.5 text-xs text-text-muted">{status}</span>
    </div>
  </div>
  <p class="mt-2 text-sm text-text-muted">{tagline}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="rounded-full bg-bg px-2 py-0.5 text-xs text-accent">{tag}</span>
    ))}
  </div>
</a>
