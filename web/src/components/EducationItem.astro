---
interface Props {
  institution: string;
  degree: string;
  date: string;
  location?: string;
  gpa?: string;
  highlights: string[];
}

const { institution, degree, date, location, gpa, highlights } = Astro.props;
---

<div class="rounded-lg border border-border bg-bg-card p-5">
  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
    <h3 class="font-semibold text-text">{institution}</h3>
    <span class="shrink-0 text-sm text-text-muted">{date}</span>
  </div>
  <div class="mt-1 flex flex-wrap items-center gap-x-2 text-sm">
    <span class="text-accent">{degree}</span>
    {location && <span class="text-text-muted">&middot; {location}</span>}
    {gpa && <span class="text-text-muted">&middot; GPA {gpa}</span>}
  </div>
  {highlights.length > 0 && (
    <ul class="mt-3 space-y-1.5">
      {highlights.map((highlight) => (
        <li class="flex gap-2 text-sm text-text-muted">
          <span aria-hidden="true" class="mt-px shrink-0 text-accent">&ndash;</span>
          <span>{highlight}</span>
        </li>
      ))}
    </ul>
  )}
</div>
